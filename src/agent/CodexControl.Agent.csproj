<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Desktop\Assets\CodexControl.ico</ApplicationIcon>
    <AssemblyName>CodexControlAgent</AssemblyName>
    <RootNamespace>CodexControl.Agent</RootNamespace>
    <Description>Standalone local control plane for Codex app-server.</Description>
    <Version>0.7.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Desktop\SettingsForm.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Desktop\Assets\CodexControlLogo.png"
                      LogicalName="CodexControl.Agent.Desktop.Assets.CodexControlLogo.png" />
    <EmbeddedResource Include="Desktop\Assets\CodexControl.ico"
                      LogicalName="CodexControl.Agent.Desktop.Assets.CodexControl.ico" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <ProjectReference Include="..\shared\CodexControl.Protocol\CodexControl.Protocol.csproj" />
  </ItemGroup>
</Project>
